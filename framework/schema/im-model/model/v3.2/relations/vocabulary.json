{
  "source": "aegi-knowledge/schema/specs/Relation_Schema_v3.md",
  "source_sha256": "a7fd36d358c82a3d8270192821b98c7deaf07af130fcc7af6e18740181968000",
  "relation_types": [
    {
      "no": 1,
      "relation_type": "has_role_on",
      "template": "Principal | Policy | Credential | Integration --[Policy]--> Resource | Tenant | Integration | Automation",
      "examples": "Entra `unifiedRoleAssignment`, Snowflake `GRANTS_TO_USERS`, GitHub PAT `permissions`, Okta `ApiServiceIntegration.granted_scopes`"
    },
    {
      "no": 2,
      "relation_type": "permits",
      "template": "Policy | Credential --> Resource",
      "examples": "Snowflake `GRANTS_TO_ROLES`, GitHub deploy key"
    },
    {
      "no": 3,
      "relation_type": "member_of",
      "template": "Principal --> Tenant | Principal | Resource",
      "examples": "GitHub org members, Graph group members"
    },
    {
      "no": 4,
      "relation_type": "owned_by",
      "template": "Endpoint | Automation | Credential --> Integration | Tenant ; Resource --> Principal ; Principal --> Integration",
      "examples": "Graph `subscription.applicationId`, Drive `File.owners`, Okta `Group.external_source_app_id`"
    },
    {
      "no": 5,
      "relation_type": "registered_in",
      "template": "Integration --> Tenant",
      "examples": "Graph `servicePrincipal`, GitHub App installation"
    },
    {
      "no": 6,
      "relation_type": "registered_by",
      "template": "Integration --> Principal",
      "examples": "Graph `createdObjects`"
    },
    {
      "no": 7,
      "relation_type": "acts_as",
      "template": "Integration --> Principal",
      "examples": "Graph `servicePrincipal.appId`"
    },
    {
      "no": 8,
      "relation_type": "authenticates_with",
      "template": "Principal | Endpoint | Integration --> Credential",
      "examples": "Snowflake PAT, Okta 앱 키, Graph `application.keyCredentials`"
    },
    {
      "no": 9,
      "relation_type": "runs_as",
      "template": "Automation --> Principal | Credential",
      "examples": "Azure Automation `identity.principalId`"
    },
    {
      "no": 10,
      "relation_type": "triggered_by",
      "template": "Automation --> Principal | Endpoint | Resource | Integration",
      "examples": "GitHub `actor`, `repository_dispatch`, ServiceNow Business Rule `table`, Azure Logic Apps `ApiConnection` 트리거"
    },
    {
      "no": 11,
      "relation_type": "receives_into",
      "template": "Endpoint --> Tenant | Resource",
      "examples": "Azure Monitor DCR `workspaceResourceId`"
    },
    {
      "no": 12,
      "relation_type": "shared_with",
      "template": "Resource --> Tenant",
      "examples": "Drive `permissions type:domain`"
    },
    {
      "no": 13,
      "relation_type": "applies_to",
      "template": "Policy --> Principal | Integration | Resource | Tenant",
      "examples": "Okta `conditions.people`, Entra `conditionalAccessUsers`, GitHub ruleset `conditions`"
    },
    {
      "no": 14,
      "relation_type": "excludes",
      "template": "Policy --> Principal | Integration | Credential | Policy",
      "examples": "Okta `conditions.people.*.exclude`, GitHub ruleset `bypass_actors`"
    },
    {
      "no": 15,
      "relation_type": "evaluates",
      "template": "Policy --> Policy",
      "examples": "Entra `conditionalAccessGrantControls.authenticationStrength`, Okta `conditions.network.include`"
    },
    {
      "no": 16,
      "relation_type": "trusts",
      "template": "Tenant --> Tenant",
      "examples": "Entra `crossTenantAccessPolicy`, Slack `team.externalTeams.list`"
    },
    {
      "no": 17,
      "relation_type": "contained_in",
      "template": "any --> any",
      "examples": "GCP `Project.parent`, Drive `File.parents`, Okta `ApplicationKeyCredential`"
    }
  ]
}
