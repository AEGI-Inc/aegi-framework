          ["security-access-review-access-item-app-info", "security-access-review-access-item-app-info_2"],
          ["security-access-review-history-item", "security-access-review-history-item_2"],
          ["security-access-review-principal-okta-admin-role", "security-access-review-principal-okta-admin-role_2"],
          ["security-access-review-sub-access-item", "security-access-review-sub-access-item_2"],
          ["AIAgent", "AIAgent_2"]
        ], "rule": "same_schema_across_specs", "check": "identical_properties", "code": "V2-S1"},
        {"pairs": [["collection-full", "collection-full-v2"], ["review-full", "review-sparse"]], "rule": "subset_view", "check": "property_subset", "code": "V2-S2"}
      ]
    },
    "github": {
      "different": [
        {"pair": ["User", "simple-user"], "code": "V2-S4", "why": "simple-user also represents organizations (repository owner); conditional on type"},
        {"pair": ["public-user", "simple-user"], "code": "V2-S4", "why": "same as above"}
      ],
      "polymorphic": [
        {"space": "simple-user", "field": "type", "cases": {"User": "public-user", "Bot": "public-user", "Organization": "organization-full"}, "code": "V2-S4"}
      ]
    },
    "gws": {
      "different": [
        {"pair": ["Member.memberKey", "User"], "code": "V2-S5", "why": "a group member key names a user, a group or the whole customer; Member.type decides"}
      ],
      "polymorphic": [
        {"space": "Member.memberKey", "field": "type", "cases": {"USER": "User", "GROUP": "Group", "CUSTOMER": "Customer"}, "code": "V2-S5"}
      ]
    },
    "jira": {
      "different": [
        {"pair": ["RemoteIssueLink", "{}_2"], "code": "V2-S6", "why": "{}_2 is an unnamed space without properties; combined score 0.43"}
      ],
      "basis": [
        {"pairs": [["FoundGroup", "GroupDetails"], ["FoundGroup", "GroupName"], ["GroupDetails", "GroupName"]], "rule": "human_q2", "check": "none", "code": "V2-S7"}
      ]
    },
    "slack": {
      "basis": [
        {"pairs": [["200.scheduled_messages[*]", "200.scheduled_messages[*]_2"]], "rule": "same_properties", "check": "identical_properties", "code": "V2-S8"}
      ]
    }
  },
  "cartography": [
    {"provider": "gws", "class": "GoogleWorkspaceUserToGroupInheritedMemberRel", "effect": "effective_access_derivation", "code": "V2-M1", "why": "nested-group inheritance is computed by Effective Access, not stored"},
    {"provider": "gws", "class": "GoogleWorkspaceGroupToGroupInheritedMemberRel", "effect": "effective_access_derivation", "code": "V2-M2", "why": "same as above"},
    {"provider": "slack", "class": "SlackGroupToChannelRel", "effect": "no_relation", "code": "V2-M3", "why": "usergroup prefs.channels is a one-time default-channel invite, not access (aegi-schema Slack_Profiles)"}
