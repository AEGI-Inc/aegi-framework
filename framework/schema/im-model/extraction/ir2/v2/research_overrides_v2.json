      "basis": [
        {"pairs": [
          ["rcar-entry-get", "rcar-entry-get_2"], ["requested", "requested_2"],
          ["reviewer-entitlement", "reviewer-entitlement_2"], ["reviewer-entitlement-bundle", "reviewer-entitlement-bundle_2"],
          ["reviewer-entitlement-value", "reviewer-entitlement-value_2"], ["reviewer-group-profile", "reviewer-group-profile_2"],
