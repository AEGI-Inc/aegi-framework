  "interfaces": [
    {"provider": "jira", "space": "ServerInformation", "interfaces": ["Tenant"], "code": "V2-T1", "why": "the Atlassian site is the tenant that Jira global administration targets; matches runtime profile site"},
    {"provider": "m365", "space": "microsoft.graph.namedLocation", "interfaces": ["Policy"], "code": "M365-I1", "why": "2026-11-20 V3.2 precedent: an IP or country range used as a Conditional Access condition, like Okta NetworkZone (Policy); not a cross-tenant data channel"},
    {"provider": "m365", "space": "microsoft.graph.device", "interfaces": ["Resource"], "code": "M365-I2", "why": "2026-11-20 V3.2 precedent: directory device record, like GWS MobileDevice and Cloud Identity Device (Resource)"},
    {"provider": "m365", "space": "microsoft.graph.managedDevice", "interfaces": ["Resource"], "code": "M365-I3", "why": "2026-11-20 V3.2 precedent: Intune managed device, like GWS ChromeOsDevice and MobileDevice (Resource)"},
    {"provider": "m365", "space": "microsoft.graph.administrativeUnit", "interfaces": ["Resource"], "code": "M365-I4", "why": "2026-11-20 V3.2 precedent: directory container that scopes administration, like GWS OrgUnit (Resource); it cannot hold permissions itself"},
    {"provider": "m365", "space": "microsoft.graph.domain", "interfaces": ["Tenant"], "code": "M365-I5", "why": "2026-11-20 V3.2 precedent: verified tenant domain, like GWS Domains (Tenant)"},
    {"provider": "m365", "space": "microsoft.graph.subscription", "interfaces": ["Endpoint"], "code": "M365-I6", "why": "2026-11-20 V3.2 precedent: change notification subscription delivering to an outside notificationUrl, like GitHub hook and Okta EventHook (Endpoint)"}
  ]
