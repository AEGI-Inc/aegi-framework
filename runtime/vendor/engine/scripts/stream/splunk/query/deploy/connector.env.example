# /etc/aegi-connector/connector.env (root:aegi-connector, 0640). 값은 이 파일에만 두고 저장소에 넣지 않는다.
# 작업 폴더의 .env.connector 를 읽지 않게 한다
AEGI_CONNECTOR_ENV_FILE=/nonexistent
# dash.aegi.site 는 데이터센터 IP에 Cloudflare 봇 확인(403, cf-mitigated: challenge)을 띄워 서버 커넥터가 붙지 못한다.
# 같은 운영 배포의 pages.dev 주소로 붙는다(커넥터 요청은 커넥터 키로 따로 인증한다)
AEGI_CONNECTOR_URL=https://aegi-dashboard-new.pages.dev
# Pages 의 AEGI_SPLUNK_CONNECTOR_KEY 와 같은 값(32자 이상)
AEGI_CONNECTOR_KEY=
# 같은 서버의 Splunk 검색 REST. 인증서는 지문으로만 확인하므로 127.0.0.1 로 붙어도 된다
SPLUNK_URL=https://127.0.0.1:8089
SPLUNK_TOKEN=
SPLUNK_TLS_SHA256=
AEGI_SPLUNK_CONFIG=/opt/aegi-connector/config.json
AEGI_SPLUNK_JOB_DIR=/var/lib/aegi-connector/jobs
# connector (default), gateway, both. During migration one process serves both.
AEGI_SPLUNK_SERVICE_MODE=connector
# Required in gateway/both. Keep :8090 loopback-only and publish via Cloudflare Tunnel.
AEGI_SPLUNK_PORT=8090
AEGI_SPLUNK_GATEWAY_TOKEN=
# Base URL of Pages (not the full graph-index path). Independent of poll/respond.
# Set URL and key together; when both are absent, old connector credentials are used.
# AEGI_GRAPH_INDEX_URL=https://aegi-dashboard-new.pages.dev
# AEGI_GRAPH_INDEX_KEY=
