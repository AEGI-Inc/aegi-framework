# /etc/aegi-connector-demo/connector.env (root:aegi-connector-demo, 0640). 값은 이 파일에만 두고 저장소에 넣지 않는다.
# 공개 데모 Gateway(aegi-connector-demo). 운영 connector.env 의 값을 하나도 옮기지 않는다.
# 작업 폴더의 .env.connector 를 읽지 않게 한다
AEGI_CONNECTOR_ENV_FILE=/nonexistent
# gateway 만. 데모는 제어면(AEGI_CONNECTOR_URL, AEGI_CONNECTOR_KEY)을 폴링하지 않는다
AEGI_SPLUNK_SERVICE_MODE=gateway
# 데모 Gateway loopback 포트. Tunnel 이 splunk-demo-query.aegi.site 를 여기로 잇는다
AEGI_SPLUNK_PORT=8091
# 데모 전용 토큰(SPLUNK-GATEWAY-DEMO-01, 32자 이상). 데모 Pages, 데모 AI Worker 의 AEGI_SPLUNK_GATEWAY_TOKEN 과 같은 값
AEGI_SPLUNK_GATEWAY_TOKEN=
# 같은 서버의 Splunk 검색 REST. 토큰은 데모 Splunk 사용자 aegi-demo-search(역할이 index aegi_demo 만 검색)
# 인증서는 지문으로만 확인하므로 127.0.0.1 로 붙어도 된다. 지문은 운영과 같은 서버 값이다
SPLUNK_URL=https://127.0.0.1:8089
SPLUNK_TOKEN=
SPLUNK_TLS_SHA256=
AEGI_SPLUNK_CONFIG=/opt/aegi-connector-demo/config.demo.json
AEGI_SPLUNK_JOB_DIR=/var/lib/aegi-connector-demo/jobs
# 로그 캐시: 미리보기 D1(aegi-dashboard-exceptions-preview, 데모 Pages 의 EXCEPTIONS_DB) id 와 그 D1 에 쓸 데모 전용 Cloudflare 토큰
AEGI_LOG_D1_ID=
CLOUDFLARE_API_TOKEN=
# 그래프 키 출처: 공개 데모 Pages(pages.dev 주소. demo.aegi.site 는 데이터센터 IP 에 봇 확인을 띄울 수 있다)
# 키는 PLAT-GRAPH-INDEX-DEMO-01, 데모 Pages 의 AEGI_GRAPH_INDEX_KEY 와 같은 값(32자 이상)
AEGI_GRAPH_INDEX_URL=https://aegi-demo-public.pages.dev
AEGI_GRAPH_INDEX_KEY=
