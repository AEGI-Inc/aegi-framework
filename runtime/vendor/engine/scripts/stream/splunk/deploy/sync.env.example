# /etc/aegi-splunk-sync/sync.env, root:root 0600. Do not commit real values.
# Only the existing Vault master and Cloudflare API token are stored here.
# SaaS and Splunk credentials are decrypted from Vault into process memory.
AEGI_VAULT_KEY=
CLOUDFLARE_API_TOKEN=
# Same host as Splunk; keep tenant, tokens and TLS pin from Vault.
AEGI_SYNC_SPLUNK_URL=https://127.0.0.1:8089
AEGI_SYNC_HEC_URL=https://127.0.0.1:8088
