[Unit]
Description=AEGI SaaS audit logs to Splunk
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=aegi-sync
Group=aegi-sync
WorkingDirectory=/var/lib/aegi-splunk-sync
EnvironmentFile=/etc/aegi-splunk-sync/sync.env
ExecStart=/usr/local/bin/node /opt/aegi-splunk-sync/sync.mjs --config /etc/aegi-splunk-sync/collector.config.json --out /var/lib/aegi-splunk-sync/data
TimeoutStartSec=25min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aegi-splunk-sync
StandardOutput=journal
StandardError=journal
