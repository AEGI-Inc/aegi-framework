# AEGI 로컬 설치판 설정. 이 파일을 .env 로 복사해 필요한 줄만 채운다.
# 비어 있는 SaaS 는 수집하지 않는다. 아무것도 채우지 않아도 `start` 는 빈 화면으로 열리고, 그래프의 「샘플로 둘러보기」로 내장 샘플을 볼 수 있다.
# 모든 수집은 읽기 전용 API 만 부른다. 값은 이 PC 밖으로 나가지 않는다(AI 질문 내용만 고른 AI 회사로 간다).

# ─── AI (하나만) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# 모델을 바꿀 때만 (기본: claude-sonnet-5-5 / gemini-3.6-flash / gpt-5.5)
# AEGI_ASSISTANT_MODEL=
# 추론 강도를 바꿀 때만 (비우면 모델별 자동, none/minimal/low/medium/high)
# AEGI_ASSISTANT_REASONING_EFFORT=

# ─── 수집 범위 ───────────────────────────────────────────────
# 감사 로그를 며칠 전부터 받을지 (기본 30)
AEGI_COLLECT_DAYS=30

# ─── GitHub: 자체 GitHub App (Manifest 권장), OAuth App 또는 PAT ─
GITHUB_ORG=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Adapters 화면에서 [새 GitHub App 생성 (Manifest)] 시 자동 저장되며, 직접 입력 시 한 줄 PEM(\n) 또는 파일 경로를 설정한다.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_FILE=
# GITHUB_OWNER_TOKEN=
# OAuth App 사용 시
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# 엔터프라이즈 감사 로그까지 볼 때
# GITHUB_ENTERPRISE=
# GITHUB_APP_ENTERPRISE_INSTALLATION_ID=

# ─── Okta: API 서비스 앱 (OAuth, private_key_jwt) ────────────
OKTA_ORG_URL=
OKTA_COLLECTOR_CLIENT_ID=
OKTA_COLLECTOR_KEY_ID=
OKTA_COLLECTOR_PRIVATE_KEY_FILE=

# ─── Slack: 조직 관리자 사용자 토큰 (admin, auditlogs:read 등) ─
SLACK_TEAM_ID=
SLACK_ENTERPRISE_ID=
SLACK_COLLECTOR_USER_TOKEN=
# SLACK_COLLECTOR_BOT_TOKEN=

# ─── Google Workspace: 서비스 계정 + 도메인 전체 위임(DWD) ───
GWS_ADMIN_SUBJECT=
GWS_COLLECTOR_SA_KEY_FILE=

# ─── Salesforce: Connected App (client credentials) ─────────
SALESFORCE_INSTANCE_URL=
SALESFORCE_COLLECTOR_CLIENT_ID=
SALESFORCE_COLLECTOR_CLIENT_SECRET=

# ─── Atlassian (Jira, Confluence) ────────────────────────────
ATLASSIAN_SITE_URL=
ATLASSIAN_COLLECTOR_EMAIL=
ATLASSIAN_COLLECTOR_API_TOKEN=
# 조직 감사 로그(Guard)까지 볼 때
# ATLASSIAN_ORG_ID=
# ATLASSIAN_COLLECTOR_ORG_API_KEY=
# ATLASSIAN_ORG_AUDIT_API_KEY=

# ─── Splunk (감사 로그: Timeline, AI 로그 검색) ──────────────
# 회사 Splunk 의 검색 REST 에 붙어 검색만 한다(쓰기 없음). 비워 두면 로그 기능이 꺼진다.
# 검색 REST 주소 (Splunk 관리 포트, 보통 8089)
SPLUNK_URL=
# 인증 토큰: 감사 로그 index 를 읽을 수 있는 검색 전용 계정으로 만든다 (Settings → Tokens)
SPLUNK_TOKEN=
# 인증서 확인. 공인 인증서면 비워 둔다. 사내 CA 면 CA 파일, 자체 서명이면 SHA-256 지문
# SPLUNK_CA_FILE=
# SPLUNK_TLS_SHA256=
# 어느 index, sourcetype 이 어느 SaaS 감사 로그인지 (splunk.sources.example.json 을 복사해 맞춘다)
# SPLUNK_SOURCES_FILE=splunk.sources.json
# 조회 결과 캐시 시간 (기본 24)
# AEGI_LOG_CACHE_HOURS=24

# ─── 서버 ────────────────────────────────────────────────────
# AEGI_PORT=5199
# 다른 PC 에서도 열려면 둘 다 둔다. 비밀번호 없이 127.0.0.1 밖으로는 열지 않는다
# AEGI_HOST=0.0.0.0
# AEGI_PASSWORD=
