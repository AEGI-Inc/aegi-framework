# AEGI 로컬 설치판 설정. 이 파일을 .env 로 복사해 필요한 줄만 채운다.
# 비어 있는 SaaS 는 수집하지 않는다. 아무것도 채우지 않아도 `start` 는 빈 화면으로 열리고, 그래프의 「샘플로 둘러보기」로 내장 샘플을 볼 수 있다.
# 모든 수집은 읽기 전용 API 만 부른다. 값은 이 PC 밖으로 나가지 않는다(AI 질문 내용만 고른 AI 회사로 간다).

# ─── AI (하나만) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# 모델을 바꿀 때만 (기본: claude-sonnet-5-5 / gemini-3.6-flash / gpt-5.5)
# AEGI_ASSISTANT_MODEL=
# 추론 강도를 바꿀 때만 (비우면 모델별 자동, none/minimal/low/medium/high)
# AEGI_ASSISTANT_REASONING_EFFORT=

# ─── 수집 범위 ───────────────────────────────────────────────
# 감사 로그처럼 기간이 있는 호출을 며칠 전부터 받을지 (기본 30). 수집할 때마다 이 기간을 처음부터 다시 읽는다
AEGI_COLLECT_DAYS=30
# 시작 시각을 고정할 때만 (AEGI_COLLECT_DAYS 보다 우선, 예: 2026-11-01T00:00:00Z)
# AEGI_COLLECT_SINCE=

# ─── GitHub: 자체 GitHub App (Manifest 권장), OAuth App 또는 PAT ─
GITHUB_ORG=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Adapters 화면에서 [새 GitHub App 생성 (Manifest)] 시 자동 저장되며, 직접 입력 시 한 줄 PEM(\n) 또는 파일 경로를 설정한다.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_FILE=
# 엔터프라이즈 소유자 classic PAT. 엔터프라이즈 감사 로그(GH-19)는 GitHub 문서상 classic PAT(read:audit_log)만 받는다. 앱 설치 토큰으로는 안 된다
# GITHUB_OWNER_TOKEN=
# OAuth App 사용 시
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# 엔터프라이즈까지 볼 때 (감사 로그 GH-19 는 위 GITHUB_OWNER_TOKEN 도 필요)
# GITHUB_ENTERPRISE=
# GITHUB_APP_ENTERPRISE_INSTALLATION_ID=

# ─── Okta: API 토큰(1순위) 또는 API 서비스 앱 (OAuth, private_key_jwt) ─
OKTA_ORG_URL=
# 1순위. 토큰은 만든 관리자의 권한을 그대로 갖는다. Read-only Administrator 계정으로 만든다. 30일 안 쓰면 Okta 가 폐기한다
# OKTA_API_TOKEN=
# API 서비스 앱을 쓸 때
OKTA_COLLECTOR_CLIENT_ID=
OKTA_COLLECTOR_KEY_ID=
OKTA_COLLECTOR_PRIVATE_KEY_FILE=

# ─── Slack: 조직 관리자 사용자 토큰 (admin, auditlogs:read 등) ─
SLACK_TEAM_ID=
SLACK_ENTERPRISE_ID=
SLACK_COLLECTOR_USER_TOKEN=
# SLACK_COLLECTOR_BOT_TOKEN=
# 1순위 OAuth 로그인에 쓰는 자체 Slack 앱 값 (Basic Information). 로그인하면 위 토큰이 저장된다
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# 앱 설정 토큰 (SL-10 앱 매니페스트, 선택). 12시간마다 만료되고 갱신 토큰으로 바뀐다
# SLACK_CONFIG_TOKEN=
# SLACK_CONFIG_REFRESH_TOKEN=

# ─── Google Workspace: 서비스 계정 + 도메인 전체 위임(DWD) ───
GWS_ADMIN_SUBJECT=
GWS_COLLECTOR_SA_KEY_FILE=

# ─── Salesforce: OAuth 로그인(1순위) 또는 Connected App (client credentials) ─
SALESFORCE_INSTANCE_URL=
SALESFORCE_COLLECTOR_CLIENT_ID=
# 1순위. Adapters 화면에서 [계정 연결]로 로그인하면 저장된다. 이 값이 있으면 client credentials 대신 이것을 쓴다
# SALESFORCE_COLLECTOR_REFRESH_TOKEN=
# 2순위 client credentials 를 쓸 때
SALESFORCE_COLLECTOR_CLIENT_SECRET=

# ─── Atlassian (Jira, Confluence) ────────────────────────────
ATLASSIAN_SITE_URL=
ATLASSIAN_COLLECTOR_EMAIL=
ATLASSIAN_COLLECTOR_API_TOKEN=
# 조직 단위 수집(조직 사용자·그룹, 조직 감사 로그)까지 볼 때. 조직 API 키 하나를 아래 두 줄에 똑같이 넣는다
# ATLASSIAN_ORG_ID=
# 조직 사용자·디렉터리·그룹 호출에 쓴다
# ATLASSIAN_COLLECTOR_ORG_API_KEY=
# 조직 감사 로그(AT-90)에 쓴다. 이 줄이 비면 조직 감사 로그 수집이 꺼진다 (Adapters 화면에서 저장하면 두 줄이 같이 채워진다)
# ATLASSIAN_ORG_AUDIT_API_KEY=

# ─── Microsoft 365 (Entra ID / Microsoft Graph) ──────────────
# M365_TENANT_ID=
# M365_CLIENT_ID=
# M365_CLIENT_SECRET=

# ─── Google Cloud / Gemini Enterprise ────────────────────────
# GCP_PROJECTS=
# GCP_DISCOVER_PROJECTS=1
# GCP_COLLECTOR_CLIENT_ID=
# GCP_COLLECTOR_CLIENT_SECRET=
# GCP_COLLECTOR_REFRESH_TOKEN=
# GCP_DISCOVERY_LOCATIONS=global
# GCP_REGIONS=

# ─── 1Password ───────────────────────────────────────────────
# ONEPASSWORD_SERVICE_ACCOUNT_TOKEN=
# ONEPASSWORD_EVENTS_TOKEN=
# ONEPASSWORD_ACCOUNT_ID=
# ONEPASSWORD_EVENTS_HOST=https://events.1password.com

# ─── Splunk (감사 로그: Timeline, AI 로그 검색) ──────────────
# 회사 Splunk 의 검색 REST 에 붙어 검색만 한다(쓰기 없음). 비워 두면 로그 기능이 꺼진다.
# 검색 REST 주소 (Splunk 관리 포트, 보통 8089)
SPLUNK_URL=
# 인증 토큰: 감사 로그 index 를 읽을 수 있는 검색 전용 계정으로 만든다 (Settings → Tokens)
SPLUNK_TOKEN=
# 인증서 확인. 공인 인증서면 비워 둔다. 사내 CA 면 CA 파일, 자체 서명이면 SHA-256 지문
# SPLUNK_CA_FILE=
# SPLUNK_TLS_SHA256=
# 어느 index, sourcetype 이 어느 SaaS 감사 로그인지 (splunk.sources.example.json 을 복사해 맞춘다)
# SPLUNK_SOURCES_FILE=splunk.sources.json
# 조회 결과 캐시 시간 (기본 24)
# AEGI_LOG_CACHE_HOURS=24

# ─── 서버 ────────────────────────────────────────────────────
# AEGI_PORT=5199
# 다른 PC 에서도 열려면 둘 다 둔다. 비밀번호 없이 127.0.0.1 밖으로는 열지 않는다
# AEGI_HOST=0.0.0.0
# AEGI_PASSWORD=
