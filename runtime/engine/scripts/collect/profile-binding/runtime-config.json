{
  "providers": {
    "atlassian": {
      "root": {
        "type": "ServerInformation",
        "when_any_call": [
          "AT-01",
          "JI-02",
          "JI-04",
          "CF-01"
        ]
      },
      "indexes": {
        "scheme_of_project": {
          "sources": [
            {
              "call": "JI-06",
              "request": {
                "project": "present"
              },
              "items": "(root)",
              "where": {
                "path": "id",
                "present": true
              }
            }
          ],
          "key": {
            "op": "str",
            "of": "$req.project"
          },
          "value": {
            "op": "str",
            "of": "id"
          }
        },
        "projects_of_scheme": {
          "sources": [
            {
              "call": "JI-06",
              "request": {
                "project": "present"
              },
              "items": "(root)",
              "where": {
                "path": "id",
                "present": true
              }
            }
          ],
          "key": {
            "op": "str",
            "of": "id"
          },
          "value": {
            "op": "str",
            "of": "$req.project"
          },
          "mode": "list"
        },
        "scheme_lines": {
          "sources": [
            {
              "call": "JI-06",
              "request": {
                "project": "absent"
              },
              "items": "permissionSchemes",
              "each": "permissions"
            }
          ],
          "key": {
            "op": "str",
            "of": "$parent.id"
          },
          "mode": "list",
          "value": {
            "object": {
              "permission": {
                "op": "str",
                "of": "permission"
              },
              "user": {
                "if": {
                  "path": "holder.type",
                  "eq": "user"
                },
                "then": {
                  "op": "nonempty",
                  "of": {
                    "any": [
                      "holder.user.accountId",
                      "holder.parameter"
                    ]
                  }
                }
              },
              "group": {
                "if": {
                  "path": "holder.type",
                  "eq": "group"
                },
                "then": {
                  "op": "nonempty",
                  "of": {
                    "any": [
                      "holder.group.groupId",
                      "holder.value"
                    ]
                  }
                }
              },
              "role": {
                "if": {
                  "all": [
                    {
                      "path": "holder.type",
                      "eq": "projectRole"
                    },
                    {
                      "path": {
                        "any": [
                          "holder.projectRole.id",
                          "holder.parameter"
                        ]
                      },
                      "truthy": true
                    }
                  ]
                },
                "then": {
                  "op": "str",
                  "of": {
                    "any": [
                      "holder.projectRole.id",
                      "holder.parameter"
                    ]
                  }
                }
              },
              "special": {
                "if": {
                  "path": "holder.type",
                  "eq": "anyone"
                },
                "then": {
                  "const": "ANONYMOUS_USERS"
                },
                "else": {
                  "if": {
                    "path": "holder.type",
                    "eq": "applicationRole"
                  },
                  "then": {
                    "if": {
                      "path": {
                        "any": [
                          "holder.parameter",
                          "holder.value"
                        ]
                      },
                      "truthy": true
                    },
                    "then": {
                      "template": "APPLICATION_ROLE_{holder.parameter|holder.value}"
                    },
                    "else": {
                      "const": "ALL_LICENSED_USERS"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "order": [
        "site.list",
        "RovoOrganization.list",
        "RovoConnector.list",
        "RovoConnector.gws-authorization",
        "JiraAutomationRule.list",
        "ConfluenceAutomationRule.list",
        "JiraAutomationRequestEndpoint.list",
        "ConfluenceAutomationRequestEndpoint.list",
