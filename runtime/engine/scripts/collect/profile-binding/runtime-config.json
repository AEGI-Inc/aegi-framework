    "salesforce": {
      "display_fields": ["Label", "MasterLabel", "FlowLabel", "Name", "DeveloperName", "ApiName", "FunctionName", "Domain", "Url", "NamespacePrefix"],
      "root": {
        "type": "Organization",
        "required": true,
        "when_any_call": [
          "SF-01",
          "SF-02"
        ],
        "note": "Salesforce: SF-01 조직 원본이 없어 Salesforce 객체를 만들지 않았다"
      },
      "indexes": {
        "saml": {
          "sources": [
            {
              "call": "SF-01",
              "items": "records",
              "where": {
                "path": "attributes.type",
                "eq": "SamlSsoConfig"
              }
            }
          ],
          "key": {
            "const": "all"
          },
          "mode": "list",
          "value": {
            "object": {
              "developer_name": "DeveloperName",
              "issuer": "Issuer",
              "identity_mapping": "IdentityMapping",
              "identity_location": "IdentityLocation",
              "login_url": {
                "op": "null_if_missing",
                "of": "LoginUrl"
              }
            }
          }
        },
        "mfa": {
          "sources": [
            {
              "call": "SF-02",
              "items": "records",
              "where": {
                "path": "attributes.type",
                "eq": "TwoFactorMethodsInfo"
              }
            }
          ],
          "key": {
            "op": "sf_id18",
            "of": "UserId"
          },
          "value": {
            "op": "true_keys",
            "of": ".",
            "prefix": "Has"
          }
        },
        "mfa_seen": {
          "sources": [
            {
              "call": "SF-02",
              "items": "records",
              "where": {
                "path": "attributes.type",
                "eq": "TwoFactorMethodsInfo"
              }
            }
          ],
          "key": {
            "const": "all"
          },
          "value": true,
          "mode": "first"
        },
        "federation": {
          "sources": [
            {
              "call": "SF-02",
              "request": {
                "part": "federation_id"
              },
              "items": "records",
              "where": {
                "all": [
                  {
                    "path": "attributes.type",
                    "eq": "User"
                  },
                  {
                    "path": "FederationIdentifier",
                    "truthy": true
                  }
                ]
              }
            }
          ],
          "key": {
            "op": "sf_id18",
            "of": "Id"
          },
          "value": {
            "op": "lower",
            "of": {
              "op": "str",
              "of": "FederationIdentifier"
            }
          }
        },
        "profile_is_custom": {
          "note": "Profile Id → 그 프로필 소유 권한 세트의 IsCustom. Profile 조회에는 기본, 사용자 정의를 가르는 칸이 없다",
          "sources": [
            {
              "call": "SF-04",
              "items": "records",
              "where": {
                "all": [
                  {
                    "path": "attributes.type",
                    "eq": "PermissionSet"
                  },
                  {
                    "path": "IsOwnedByProfile",
                    "truthy": true
                  }
                ]
              }
            }
          ],
          "key": {
            "op": "sf_id18",
            "of": "ProfileId"
          },
          "value": "IsCustom",
          "mode": "first"
        },
        "ps_owner_profile": {
          "note": "프로필 소유 권한 세트 Id → Profile Id. 권한 내용 행(ParentId)을 Profile 에 접을 때 쓴다",
          "sources": [
            {
              "call": "SF-04",
              "items": "records",
              "where": {
                "all": [
                  {
                    "path": "attributes.type",
                    "eq": "PermissionSet"
                  },
                  {
                    "path": "IsOwnedByProfile",
                    "truthy": true
                  }
                ]
              }
            }
          ],
          "key": {
            "op": "sf_id18",
            "of": "Id"
          },
          "value": {
            "op": "sf_id18",
            "of": "ProfileId"
          },
          "mode": "first"
        }
      },
