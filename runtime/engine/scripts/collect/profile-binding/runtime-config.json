    "github": {
      "root": {
        "type": "organization-full",
        "required": true,
        "note": "GitHub: GH-01 조직 원본이 없어 GitHub 객체를 만들지 않았다"
      },
      "indexes": {
        "env_by_name": {
          "sources": [
            {
              "call": "GH-24",
              "items": "environments",
              "where": {
                "has": {
                  "type": "Repository",
                  "lookup": "name",
                  "value": "$req.repo"
                }
              }
            }
          ],
          "key": {
            "template": "{$req.repo}|{name}"
          },
          "value": {
            "ref": {
              "type": "environment",
              "id": "id"
            },
            "prop": "$key"
          }
        },
        "pat_repos": {
          "sources": [
            {
              "call": "GH-13",
              "request": {
                "pat_id": "present"
              },
              "items": "(root)"
            }
          ],
          "key": {
            "op": "str",
            "of": "$req.pat_id"
          },
          "value": {
            "op": "pluck",
            "of": {
              "if": {
                "path": ".",
                "is_array": true
              },
              "then": ".",
              "else": {
                "const": []
              }
            },
            "field": "full_name",
            "keep_empty": true
          }
        },
        "secret_repos": {
          "sources": [
            {
              "call": "GH-25",
              "request": {
                "secret": "present"
              },
              "items": "repositories",
              "where": {
                "has": {
                  "type": "Repository",
                  "lookup": "name",
                  "value": "name"
                }
              }
            }
          ],
          "key": {
            "template": "{$req.kind}|{$req.secret}"
          },
          "value": {
            "object": {
              "key": {
                "ref": {
                  "type": "Repository",
                  "lookup": "name",
                  "value": "name"
                },
                "prop": "$key"
              },
              "value": {
                "op": "str",
                "of": {
                  "any": [
                    "full_name",
                    "name"
                  ]
                }
              }
            }
          },
          "mode": "list"
        },
        "group_repos": {
          "sources": [
            {
              "call": "GH-32",
              "request": {
                "kind": "repositories"
              },
              "items": "(root)"
            }
          ],
          "key": {
            "op": "str",
            "of": "$req.runner_group"
          },
          "value": {
            "op": "map_each",
            "of": {
              "op": "filter",
              "of": "repositories",
              "where": {
                "has": {
                  "type": "Repository",
                  "lookup": "name",
                  "value": "$item.name"
                }
              }
            },
            "value": {
              "object": {
                "key": {
                  "ref": {
                    "type": "Repository",
                    "lookup": "name",
                    "value": "$item.name"
                  },
                  "prop": "$key"
                },
                "value": {
                  "op": "str",
                  "of": {
                    "any": [
                      "$item.full_name",
                      "$item.name"
                    ]
                  }
                }
              }
            }
          }
        },
        "pr_by_ref": {
          "sources": [
            {
              "call": "GH-12",
              "request": {
                "number": "present",
                "kind": "absent"
              },
              "items": "(root)",
              "where": {
                "all": [
                  {
                    "path": ".",
                    "is_array": false
                  },
                  {
                    "has": {
                      "type": "Repository",
                      "lookup": "name",
                      "value": "$req.repo"
                    }
                  }
                ]
              }
            }
          ],
          "key": {
            "template": "{$req.repo}#{number}"
          },
          "value": {
            "ref": {
              "type": "pull-request",
              "id": "id"
            },
            "prop": "$key"
          }
        }
      },
